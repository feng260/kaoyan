# ---- 服务 ----
PORT=3000
NODE_ENV=development

# ---- 数据库(MySQL 8+) ----
# 本地开发示例;Docker 部署时由 docker-compose 注入容器内网地址,此项被忽略
DATABASE_URL="mysql://root:yourpassword@localhost:3306/yanzhong"

# ---- Docker Compose 专用 ----
# 仅在 docker compose 部署时使用:MySQL 容器 root 密码,compose 会据此拼出 DATABASE_URL
# 本地开发用不到,但 compose 要求必须存在,否则启动会直接报错退出
MYSQL_ROOT_PASSWORD=

# ---- JWT ----
# 必改:生产环境用 `openssl rand -hex 64` 生成
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=2h

# ---- 会话 ----
# 记住我 refresh token 有效期 / 普通有效期
REFRESH_REMEMBER_DAYS=30
REFRESH_DEFAULT_DAYS=7

# ---- SMTP(注册与找回密码的验证码邮件;未配置时验证码接口返回 503,没有日志降级) ----
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="研钟 <no-reply@yanzhong.app>"

# ---- CORS(逗号分隔的允许来源;开发留空 = 允许全部) ----
CORS_ORIGINS=

# ---- 应用更新分发(管理员上传 APK 的令牌;不配置则禁止上传) ----
ADMIN_TOKEN=

# 行程调整引擎:elastic(默认,近期弹性调整)| legacy(旧版整窗重排,仅回滚用)
PLAN_ADJUST_ENGINE=elastic

# ---- AI 计划生成(OpenAI 兼容接口;生成计划需要配置 LLM_API_KEY) ----
# DeepSeek:   LLM_BASE_URL=https://api.deepseek.com             LLM_MODEL=deepseek-flash
# 豆包方舟:   LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3   LLM_MODEL=<接入点 ID>
# 智谱:       LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4-flash
# 硅基流动:   LLM_BASE_URL=https://api.siliconflow.cn/v1        LLM_MODEL=deepseek-ai/DeepSeek-V3
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_MS=120000
LLM_MAX_TOKENS=8192
# 可选:管理后台按单价估算 AI 成本(人民币/百万 token);0 或留空表示不展示
LLM_PRICE_IN_PER_1M=0
LLM_PRICE_OUT_PER_1M=0

# ---- 视觉模型(识别用户上传的课表/作息表图片;一般不用配) ----
# 默认整套沿用上面的 LLM_*(对话模型本身能收图片就直接用,不需要额外配置)。
# 只有当识图要单独走另一个模型时,才填 LLM_VISION_MODEL;BASE_URL / API_KEY 也可各自覆盖。
# 注意:若对话模型是多模态、识图也用它,下面三项全部留空即可。
# 硅基流动:   LLM_VISION_BASE_URL=https://api.siliconflow.cn/v1              LLM_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
# 豆包方舟:   LLM_VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3   LLM_VISION_MODEL=<vision 接入点 ID>
# 智谱:       LLM_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4       LLM_VISION_MODEL=glm-4v-flash
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=
LLM_VISION_MODEL=

# ---- 邀测邀请码(逗号分隔;生产不配置则注册返回 INVITE_REQUIRED) ----
INVITE_CODES=

# ---- AI 用量告警(只告警不拦截) ----
AI_ALERT_DAILY_TOKENS=8000000
AI_ALERT_JOB_TOKENS=500000
# 告警收件人;留空则沿用 SMTP_FROM
ALERT_EMAIL=

# ---- 备份(主机上的 rclone 与死信告警,不进容器) ----
COS_BUCKET=
HEALTHCHECK_BACKUP_URL=
