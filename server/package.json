{
  "name": "yanzhong-server",
  "version": "1.0.0",
  "description": "研钟 App 后端:用户认证、多设备状态同步、数据备份(原生 Koa + TypeScript + MySQL/Prisma)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "prisma db push --skip-generate && node dist/index.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "smoke:api": "node scripts/phase0-api-smoke.mjs",
    "eval:plan": "tsx scripts/eval-plan.ts",
    "typecheck": "tsc -p tsconfig.test.json && tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "dependencies": {
    "@koa/router": "^13.1.0",
    "@prisma/client": "^6.2.1",
    "app-info-parser": "^1.1.6",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "koa": "^2.15.3",
    "koa-bodyparser": "^4.4.1",
    "koa-helmet": "^8.0.1",
    "nodemailer": "^10.5.0",
    "swagger-ui-dist": "^5.18.2",
    "ws": "^8.18.0",
    "yaml": "^2.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/koa": "^2.15.0",
    "@types/koa__router": "^12.0.4",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/ws": "^8.5.13",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
