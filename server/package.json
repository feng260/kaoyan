{
  "name": "yanzhong-server",
  "version": "1.0.0",
  "description": "研钟 App 后端:用户认证、多设备状态同步、数据备份(原生 Koa + TypeScript + MySQL/Prisma)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "prisma db push --accept-data-loss && node dist/index.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "@koa/router": "^13.1.0",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "koa": "^2.15.3",
    "koa-bodyparser": "^4.4.1",
    "koa-helmet": "^8.0.1",
    "nodemailer": "^6.9.16",
    "swagger-ui-dist": "^5.18.2",
    "ws": "^8.18.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/koa": "^2.15.0",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa__router": "^12.0.4",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/ws": "^8.5.13",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
